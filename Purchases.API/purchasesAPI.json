        "required": [
          "name",
          "supplierCen"
        ],
        "type": "object",
        "properties": {
          "supplierCen": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
