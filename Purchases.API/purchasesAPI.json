            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "PurchaseOrderDetailDto": {
        "required": [
          "items",
          "orderCen",
          "supplierCen",
          "warehouseCen"
        ],
        "type": "object",
        "properties": {
          "orderCen": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/PurchaseStatusEnum"
