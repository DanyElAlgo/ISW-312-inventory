        "required": [
          "orderCen",
          "supplierCen"
        ],
        "type": "object",
        "properties": {
          "orderCen": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/PurchaseStatusEnum"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
