      "PurchaseOrderDetailItemDto": {
        "required": [
          "productCen"
        ],
        "type": "object",
        "properties": {
          "productCen": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
