# Purchases.API environment — copy to ".env" and adjust. The real .env is gitignored.

# Postgres connection (shared convention; "__" maps to ConnectionStrings:DefaultConnection).
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=inventory_db;Username=postgres;Password=admin

# Inventory module base URL. Down-simulation for the Polly/503 demo: http://url-invalida-simulada:9999
INVENTORY_URL=http://localhost:5143

# Frontend origin(s) allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173
