# Purchases.API environment — copy to ".env" and adjust. The real .env is gitignored.
# In the cloud (App Runner) these are injected as environment variables; the
# connection string comes from AWS Secrets Manager.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=inventory_db;Username=postgres;Password=CHANGE_ME_LOCALLY

INVENTORY_URL=http://localhost:5001

CORS_ORIGINS=http://localhost:5173

EVENT_BUS_NAME=
AWS_REGION=us-east-1
